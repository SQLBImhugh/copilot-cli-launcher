<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CopilotLauncher.Pages.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CopilotLauncher.ViewModels"
    xmlns:controls="using:CopilotLauncher.Controls"
    xmlns:local="using:CopilotLauncher.Pages"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    FontFamily="{ThemeResource BodyFontFamily}">

    <Grid Padding="{ThemeResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Cleanup" Style="{StaticResource TitleLargeTextBlockStyle}" FontFamily="{ThemeResource HeadingFontFamily}" FontSize="{ThemeResource PageTitleFontSize}"/>
            <TextBlock Text="Find throwaway sessions and delete them in bulk. Sessions currently in use can never be deleted."
                       Opacity="0.7" Style="{StaticResource BodyTextBlockStyle}"/>
        </StackPanel>

        <!-- Category chips -->
        <controls:WrapPanel Grid.Row="1" HorizontalSpacing="20" VerticalSpacing="6">
            <CheckBox Content="Empty" MinWidth="0"
                      AutomationProperties.AutomationId="CleanupFilterEmpty"
                      ToolTipService.ToolTip="Started but never used — no conversation on disk"
                      IsChecked="{x:Bind ViewModel.ShowEmpty, Mode=TwoWay}"/>
            <CheckBox Content="Test probes" MinWidth="0"
                      AutomationProperties.AutomationId="CleanupFilterProbes"
                      ToolTipService.ToolTip="Smoke tests like 'hi', '--help', 'reply with exactly: OK'"
                      IsChecked="{x:Bind ViewModel.ShowProbes, Mode=TwoWay}"/>
            <CheckBox Content="Repeated prompts" MinWidth="0"
                      AutomationProperties.AutomationId="CleanupFilterDuplicates"
                      ToolTipService.ToolTip="First prompt is identical to another session — automated or repeated runs"
                      IsChecked="{x:Bind ViewModel.ShowDuplicates, Mode=TwoWay}"/>
            <CheckBox Content="Scratch dirs" MinWidth="0"
                      AutomationProperties.AutomationId="CleanupFilterScratch"
                      ToolTipService.ToolTip="Ran from a temp directory"
                      IsChecked="{x:Bind ViewModel.ShowScratch, Mode=TwoWay}"/>
            <CheckBox Content="Everything else" MinWidth="0"
                      AutomationProperties.AutomationId="CleanupFilterNormal"
                      ToolTipService.ToolTip="Sessions that look like real work — off by default"
                      IsChecked="{x:Bind ViewModel.ShowNormal, Mode=TwoWay}"/>
        </controls:WrapPanel>

        <CheckBox Grid.Row="2" MinWidth="0"
                  Content="Protect my work (hide sessions you named or that have 5+ summaries)"
                  AutomationProperties.AutomationId="CleanupProtectCheckBox"
                  IsChecked="{x:Bind ViewModel.ProtectMyWork, Mode=TwoWay}"/>

        <TextBox Grid.Row="3"
                 AutomationProperties.AutomationId="CleanupSearchBox"
                 PlaceholderText="Filter by prompt, path, or session id…"
                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Toolbar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button Content="Select all shown" Click="OnSelectAllClick"
                    AutomationProperties.AutomationId="CleanupSelectAllButton"/>
            <Button Content="Select none" Click="OnSelectNoneClick"
                    AutomationProperties.AutomationId="CleanupSelectNoneButton"/>
            <Button Content="🗑 Delete selected"
                    AutomationProperties.AutomationId="CleanupDeleteButton"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Click="OnDeleteSelectedClick"/>
            <Button Content="↻ Rescan" Click="OnRefreshClick"
                    AutomationProperties.AutomationId="CleanupRefreshButton"/>
            <muxc:ProgressRing Width="18" Height="18" VerticalAlignment="Center"
                               IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                       VerticalAlignment="Center" Opacity="0.85"
                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
        </StackPanel>

        <!-- Table header: widths must match the row template below. -->
        <Grid Grid.Row="5" VerticalAlignment="Top" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="8,0,8,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="104"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Session" Opacity="0.6" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBlock Grid.Column="2" Text="Why listed" Opacity="0.6" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBlock Grid.Column="3" Text="Size" Opacity="0.6" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBlock Grid.Column="4" Text="Last used" Opacity="0.6" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}"/>
            </Grid>

            <ListView Grid.Row="1"
                      AutomationProperties.AutomationId="CleanupList"
                      ItemsSource="{x:Bind ViewModel.Visible, Mode=OneWay}"
                      SelectionMode="None"
                      Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CleanupRow">
                        <Border Padding="8,6" Opacity="{x:Bind RowOpacity}">
                            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="104"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" MinWidth="0" Width="28" Padding="0" Margin="0"
                                          VerticalAlignment="Center"
                                          IsEnabled="{x:Bind CanDelete}"
                                          AutomationProperties.Name="{x:Bind AccessibleName}"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/>

                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Cwd}" Opacity="0.7"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Cwd}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Opacity="0.6"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"/>

                                <TextBlock Grid.Column="3" Text="{x:Bind SizeDisplay}" Opacity="0.75"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"/>

                                <StackPanel Grid.Column="4" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind LastUsedDate}" HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind LastUsedRelative}" Opacity="0.5" HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border Grid.Row="6"
                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="12,6">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.8"/>
        </Border>
    </Grid>
</Page>
